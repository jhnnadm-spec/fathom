# Copy this file to ".env.local" for running the app on your own computer.
# Never commit real values. On Vercel and GitHub, set them in the project settings instead.

# Required by the SEC: identify who is downloading data.
# Format: "Your Name your.email@example.com"
SEC_USER_AGENT=

# AI that writes the plain-English explanations (Cloudflare Workers AI, free allowance).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b

# Database for explanations written on demand (Supabase). Server-only: never expose the secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Any long random text; makes visitor fingerprints impossible to reverse.
VISITOR_SALT=
# Optional limits: explanations per day (UTC) and new companies per visitor per day.
# EXPLAIN_DAILY_LIMIT=6
# EXPLAIN_VISITOR_LIMIT=3
